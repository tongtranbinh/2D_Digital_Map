# =============================================================================
# Ship Tracking — Environment Configuration
# Được load bởi systemd EnvironmentFile và run-ui.sh
# Chỉnh sửa file này để thay đổi config, không cần rebuild binary.
# =============================================================================

# --- PostgreSQL / PostGIS ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ship_tracking
DB_USER=ship_user
DB_PASSWORD=123456

# --- TCP Telemetry Server ---
# Port lắng nghe dữ liệu từ thiết bị tàu
TCP_PORT=9000

# --- OSM Tile Server ---
# Dùng trong docker-compose, không cần thay đổi trừ khi đổi host
OSM_TILE_PORT=8080
